DYADTETRADE_ENVIRONMENT=development
DYADTETRADE_HOST=127.0.0.1
DYADTETRADE_PORT=8000
DYADTETRADE_LOG_LEVEL=INFO
DYADTETRADE_SQLITE_URL=sqlite+aiosqlite:///./data/sqlite/dyadtetrade.db
DYADTETRADE_DUCKDB_PATH=./data/duckdb/research.duckdb
DYADTETRADE_DATA_ROOT=./data
DYADTETRADE_ENABLE_LIVE_TRADING=false
DYADTETRADE_EXECUTION_MODE=disabled
DYADTETRADE_ENABLE_QMT_SIM_TRADING=false
DYADTETRADE_ENABLE_QMT_LIVE_TRADING=false
DYADTETRADE_QMT_ACCOUNT_ID=
DYADTETRADE_QMT_ACCOUNT_TYPE=STOCK
DYADTETRADE_QMT_USERDATA_PATH=
DYADTETRADE_QMT_ACCOUNT_IS_SIMULATED=false
DYADTETRADE_MAX_ORDER_NOTIONAL=10000
DYADTETRADE_MAX_DAILY_NOTIONAL=50000
DYADTETRADE_MAX_ORDERS_PER_MINUTE=5
DYADTETRADE_MAX_SYMBOL_POSITION_NOTIONAL=20000
DYADTETRADE_MAX_TOTAL_POSITION_NOTIONAL=100000
DYADTETRADE_MAX_TOTAL_POSITION_RATIO=0.80
DYADTETRADE_MAX_DAILY_ORDERS=100
DYADTETRADE_MAX_STRATEGY_DAILY_NOTIONAL=20000
DYADTETRADE_ALLOWED_SYMBOLS=
DYADTETRADE_ENABLE_DYNAMIC_EXECUTION_UNIVERSE=false
DYADTETRADE_EXECUTION_UNIVERSE_RELEASE_ID=
DYADTETRADE_ENABLE_FULL_MARKET_LIVE_TRADING=false
DYADTETRADE_FULL_MARKET_LIVE_CONFIRMATION=
DYADTETRADE_FULL_MARKET_LIVE_RELEASE_DATE=
DYADTETRADE_ENABLE_AUTOMATED_STRATEGY_EXECUTION=false
DYADTETRADE_AUTOMATED_LIVE_CONFIRMATION=
DYADTETRADE_AUTOMATED_LIVE_RELEASE_DATE=
DYADTETRADE_QMT_LIVE_ACCOUNT_WHITELIST=
DYADTETRADE_QMT_LIVE_CONFIRMATION=
DYADTETRADE_QMT_LIVE_RELEASE_DATE=
DYADTETRADE_USER_STRATEGIES_PATH=./user_strategies
DYADTETRADE_ENABLE_REALTIME_COMPUTE=true
DYADTETRADE_REALTIME_SYMBOLS=600519.SH,510300.SH
DYADTETRADE_REALTIME_POLL_INTERVAL_SECONDS=2
DYADTETRADE_REALTIME_FACTOR_LOOKBACK=20
DYADTETRADE_REALTIME_SMALL_CAP_CANDIDATES=50
# Optional local QMT SDK site-packages directory. Keep empty for Mock/Paper mode.
DYADTETRADE_XTQUANT_PATH=
# Optional market-data overrides. Uncomment and point them at your licensed local QMT install.
# DYADTETRADE_DATA__QMT__USERDATA_MINI=D:/path/to/userdata_mini
# DYADTETRADE_DATA__QMT__BIG_DATA_DIR=D:/path/to/QMT/datadir
# DYADTETRADE_DATA__QMT__SITE_PACKAGES=D:/path/to/QMT/bin.x64/Lib/site-packages
# DYADTETRADE_DATA__QMT__SIDECAR_PYTHON=.xtdata-venv/Scripts/python.exe
# DYADTETRADE_DATA__STORAGE__ROOT=../DyadResearch/data/sqlite
DYADTETRADE_MARKET_DOWNLOAD_MAX_RETRIES=2
DYADTETRADE_MARKET_DOWNLOAD_RETRY_BACKOFF_SECONDS=0.25
DYADTETRADE_MARKET_PIPELINE_VERSION=market-v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
